{
    "general": {
        "rawOutputFolder": "./rawResults/",
        "logFolder": "./logs/",
        "writeLogstoConsole": true
    },
    "azure": {
        "enabled": true,
        "queryFolder": "./collectionScripts/azure",
        "requiredModules": [
            "Az.ResourceGraph",
            "Az.Accounts"
        ]
    },
    "entra": {
        "enabled": false,
        "requiredModules": [
            "Microsoft.Graph.Authentication",
            "Microsoft.Graph.DirectoryObjects",
            "Microsoft.Graph.Applications",
            "Microsoft.Graph.Identity.DirectoryManagement",
            "Microsoft.Graph.Identity.SignIns",
            "Microsoft.Graph.Identity.Governance",
            "Microsoft.Graph.Beta.Identity.DirectoryManagement",
            "Microsoft.Graph.Beta.Identity.SignIns"
        ],
        "scopes": [
            "RoleManagement.Read.Directory",
            "Application.Read.All",
            "DeviceManagementServiceConfig.Read.All",
            "Domain.Read.All",
            "LicenseAssignment.Read.All",
            "Policy.Read.All",
            "DirectoryRecommendations.Read.All"
        ],
        "scriptFolder": "./collectionScripts/entra",
        "translateObjectIds": false,
        "filesToTranslate": [
            {
                "fileName": "azure-policy-assignments.json",
                "attributesContainingObjectId": [
                    "properties.metadata.createdBy",
                    "properties.metadata.updatedBy",
                    "properties.identity.userAssignedIdentities",
                    "identity.principalId",
                    "systemData.lastModifiedBy",
                    "systemData.createdBy"
                ]
            },
            {
                "fileName": "entraConditionalAccessPolicies.json",
                "attributesContainingObjectId": [
                    "Conditions.Users.ExcludeGroups",
                    "Conditions.Users.ExcludeUsers",
                    "Conditions.Users.IncludeGroups",
                    "Conditions.Users.IncludeUsers"
                ]
            },
            {
                "fileName": "RBAC.json",
                "attributesContainingObjectId": [
                    "principalId",
                    "createdBy",
                    "updatedBy"
                ]
            }
        ]
    }
}